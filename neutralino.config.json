{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "io.instalerup.myqr",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/index.html",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "storage.*",
    "debug.log"
  ],
  "globalVariables": {
  },
  "modes": {
    "window": {
      "title": "MyQR",
      "width": 1280,
      "height": 960,
      "minWidth": 720,
      "minHeight": 540,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/img/appIcon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true,
      "newWindowPolicy": "browser"
    },
    "browser": {
      "globalVariables": {
      },
      "nativeBlockList": [
        "filesystem.*"
      ]
    },
    "cloud": {
      "url": "/resources/#cloud",
      "nativeAllowList": [
        "app.*"
      ]
    },
    "chrome": {
      "width": 800,
      "height": 500,
      "args": "--user-agent=\"Neutralinojs chrome mode\"",
      "nativeBlockList": [
        "filesystem.*",
        "os.*"
      ]
    }
  },
  "cli": {
    "binaryName": "MyQR",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
	"resourcesExclude": "(\\.tmp|\\.git|dist|neutralino\\.config\\.json)",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}